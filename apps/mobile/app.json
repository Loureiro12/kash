{
  "expo": {
    "name": "Kash",
    "slug": "kash",
    "version": "1.0.0",
    "scheme": "kash",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0C0E",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kash.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/brand/icon-1024.png",
        "dark": "./assets/brand/icon-dark-1024.png"
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.kash.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-432-android-adaptive-fg.png",
        "backgroundColor": "#C6F432",
        "monochromeImage": "./assets/brand/icon-432-android-adaptive-mono.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-logo-1024-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C6F432",
          "dark": {
            "image": "./assets/brand/splash-logo-1024-transparent.png",
            "backgroundColor": "#C6F432"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/icon-432-android-adaptive-mono.png",
          "color": "#C6F432",
          "defaultChannel": "reminders"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
