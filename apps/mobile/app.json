{
  "expo": {
    "name": "Kash",
    "slug": "kash",
    "version": "1.1.0",
    "scheme": "kash",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0C0E",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andreloureiro.kash",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Fatura ou extrato",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf",
              "public.comma-separated-values-text",
              "com.intuit.ofx"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.intuit.ofx",
            "UTTypeDescription": "Extrato OFX",
            "UTTypeConformsTo": [
              "public.data",
              "public.text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "ofx"
              ],
              "public.mime-type": [
                "application/x-ofx"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "icon": {
        "light": "./assets/brand/icon-1024.png",
        "dark": "./assets/brand/icon-dark-1024.png"
      }
    },
    "android": {
      "package": "com.andreloureiro.kash",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-432-android-adaptive-fg.png",
        "backgroundColor": "#C6F432",
        "monochromeImage": "./assets/brand/icon-432-android-adaptive-mono.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "text/csv"
            },
            {
              "scheme": "content",
              "mimeType": "text/comma-separated-values"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-ofx"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-logo-1024-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C6F432",
          "dark": {
            "image": "./assets/brand/splash-logo-1024-transparent.png",
            "backgroundColor": "#C6F432"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/icon-432-android-adaptive-mono.png",
          "color": "#C6F432",
          "defaultChannel": "reminders"
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Kash usa o Face ID para desbloquear o app e proteger suas finanças."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/6aa3abe4-efa8-42a1-a362-0177fc216a53"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6aa3abe4-efa8-42a1-a362-0177fc216a53"
      }
    },
    "owner": "loureiro_12"
  }
}
