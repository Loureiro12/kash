{
  "name": "kash-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "ios": "pnpm --filter mobile ios",
    "android": "pnpm --filter mobile android",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --filter=!@kash/supabase-client",
    "e2e:ios": "pnpm --filter mobile e2e:ios",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "pnpm --filter @kash/supabase-client gen:types",
    "test:backend": "pnpm db:test && pnpm --filter @kash/supabase-client test",
    "db:link": "supabase link --project-ref \"$SUPABASE_PROJECT_REF\"",
    "db:push": "supabase db push --linked",
    "config:push": "scripts/config-push.sh",
    "functions:deploy": "supabase functions deploy delete-account --project-ref \"$SUPABASE_PROJECT_REF\"",
    "deploy:backend": "pnpm db:push && pnpm functions:deploy && pnpm config:push",
    "test:all": "pnpm test && pnpm test:backend",
    "dev:prod": "pnpm --filter mobile start:prod"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
